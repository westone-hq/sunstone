<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <!-- 읽기: 기어, 문, 좌석·벨트, 창문, 와이퍼, 공조 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.READ_WINDSHIELD_WIPERS" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <!-- 읽기: 벨트 미착용 경고(Safety). normal, 설치 때 허가 -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <!-- 읽기: 연료·연비·배터리(CAR_ENERGY), 주행 가능 거리(CAR_INFO 또는 CAR_ENERGY, 실측으로 확인) -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <!-- 제어: Playground에서는 아직 "준비 중". 에뮬레이터에서는 선언만으로 동작한 사례가 있다. -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_WINDSHIELD_WIPERS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_SEATS" />
    <!-- 속도(AAOS, 런타임 권한) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- 주행 가능 거리·남은 연료·남은 배터리(AAOS, 런타임 권한)와 탱크·배터리 용량(AAOS, 설치 때 허가) -->
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <!-- 내비(NaviHelper): 경로 상태·목적지·경유지 읽기(NAVI_ROUTE), 경로 요청·경유지·취소(NAVI_ROUTE_SEARCH),
         안내 이벤트(NAVI_NOTIFY). 셋 다 normal, 설치 때 허가 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_NOTIFY" />
    <!-- 위치(FusedLocation): 현재 위치·근접 알림. dangerous, MainActivity에서 요청 -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- Pleos 음성 합성(앱이 하는 말, VoicePlayer). protection normal -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- 길안내·루틴 중 앱을 깨어 있게 하는 포그라운드 서비스(Android 14: 종류를 밝힌다)와 그 알림(런타임 권한) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 왼쪽 구역(시스템 주행 화면) 위에 패널을 띄운다. 시연에서는 adb appops로 허가한다(LeftZoneOverlay) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".SunstoneApp"
        android:allowBackup="false"
        android:label="Sunstone"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <!-- 주행 중에도 열 수 있다. 주행 중 화면은 상태 한 줄만 보인다. -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Gleo: assets/schema.json 의 함수 3개 -->
            <intent-filter>
                <action android:name="RUN_ROUTINE" />
                <action android:name="UNDO_ROUTINE" />
                <action android:name="SAVE_SEAT_PROFILE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Pleos 차에서 앱 화면이 뜰 때 켜고 끄지 않는다. 위치·미디어 같은 정해진 종류에 맞지 않아 specialUse -->
        <service
            android:name=".connect.KeepAwakeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="내비 화면이 앞에 있어도 장소 도착·탑승 같은 차 상황을 받아 차 설정 루틴을 권하고 되돌려야 한다" />
        </service>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
